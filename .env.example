# ── Frontend (injected at Vite build time, must have VITE_ prefix) ──────────

VITE_RAINDROP_CLIENT_ID=your_client_id_here

# Local development:
# VITE_REDIRECT_URI=http://localhost:5173/callback
# VITE_PROXY_API_URL=http://localhost:3001/api

# Production (Vercel):
VITE_REDIRECT_URI=https://your-project.vercel.app/callback
VITE_PROXY_API_URL=https://your-project.vercel.app/api
